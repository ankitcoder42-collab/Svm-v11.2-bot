# Required before starting the bot
DISCORD_TOKEN=
MAIN_ADMIN_ID=0
VPS_USER_ROLE_ID=0

# Existing SVM bot
BOT_NAME=SVM V11.2
BOT_VERSION=11.2-PRO
BOT_DEVELOPER=AnkitCoder
PREFIX=!
YOUR_SERVER_IP=127.0.0.1
DEFAULT_STORAGE_POOL=default
DEFAULT_VPS_EXPIRATION_DAYS=30
EXPIRATION_WARNING_DAYS=1

# Public VPS provisioning. Review quotas before enabling on a live server.
PUBLIC_VPS_ENABLED=true
PUBLIC_VPS_MAX_RAM=4
PUBLIC_VPS_MAX_CPU=2
PUBLIC_VPS_MAX_DISK=50
PUBLIC_VPS_EXPIRY_DAYS=30
PUBLIC_VPS_MAX_PER_USER=1
PUBLIC_VPS_MAX_PER_IP=3
PUBLIC_VPS_REQUIRE_VERIFICATION=false
PUBLIC_VPS_RENEWAL_ENABLED=true
PUBLIC_VPS_RENEWAL_DAYS=30

# WebSSH is disabled by default. If enabled, allow only literal IP addresses
# and keep it behind an authenticated HTTPS reverse proxy.
WEBSSH_ENABLED=false
WEBSSH_PORT=5000
WEBSSH_BIND_HOST=127.0.0.1
WEBSSH_SERVER_IP=127.0.0.1
WEBSSH_URL_FORMAT=http://{SERVER_IP}:{PORT}
WEBSSH_ALLOWED_HOSTS=
MAX_WEBSSH_SESSIONS=25

# LocalAI (OpenAI-compatible API). Start LocalAI separately and set its model ID.
AI_ENABLED=true
AI_PROVIDER=localai
AI_AGENT_ENABLED=true
LOCALAI_BASE_URL=http://127.0.0.1:8080
LOCALAI_API_KEY=
LOCALAI_MODEL=
AI_TIMEOUT=180
AI_MAX_OUTPUT=4096
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_CONTEXT_CHARS=24000
AI_MEMORY=true
AI_SESSION_RETENTION_DAYS=90
AI_USAGE_RETENTION_DAYS=365
AI_USER_RPM=10
AI_USER_DAILY_LIMIT=200
AI_MAX_CONCURRENT_TASKS=3

# Optional post-provisioning command. Off unless explicitly enabled.
HOST_MOTD_ENABLED=false
HOST_MOTD=

# Existing payment/provider configuration
SVM_PUBLIC_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_ENABLED=false
UPI_ID=
UPI_NAME=AnkitCoder
UPI_QR_URL=
PAYMENT_INSTRUCTIONS=
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8787

# Optional panel settings
PANEL_DOMAIN=
SVM_PANEL_REPO=https://github.com/AnkitKing7/Svm-v4.git
SVM_PANEL_DIR=/opt/svm-panel
PLAN_STARTER_PRICE=0
PLAN_BASIC_PRICE=0
PLAN_STANDARD_PRICE=0
PLAN_PRO_PRICE=0